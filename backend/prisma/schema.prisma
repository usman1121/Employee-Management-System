generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  department_id String     @id @default(uuid())
  name          String     @unique @db.VarChar(100)
  description  String?    @db.Text
  employees     Employee[]
}

model Address {
  address_id String     @id @default(uuid())
  country    String     @db.VarChar(100)
  city       String     @db.VarChar(100)
  state      String?    @db.VarChar(100)
  employees  Employee[]
}

model Employee {
  employee_id       String           @id @default(uuid())
  full_name         String           @db.VarChar(100)
  email             String           @unique @db.VarChar(150)
  password          String           @db.Text
  phone             String?          @db.VarChar(20)
  role              String           @db.VarChar(20)
  status            String           @default("Active") @db.VarChar(20)
  hire_date         DateTime         @db.Date
  position          String?          @db.VarChar(100)
  department_id     String?
  department        Department?      @relation(fields: [department_id], references: [department_id])
  address_id        String?
  address           Address?         @relation(fields: [address_id], references: [address_id])
  created_at        DateTime         @default(now()) @db.Timestamp
  updated_at        DateTime?        @db.Timestamp
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]   @relation("LeaveRequestEmployee")
  approvedLeaves    LeaveRequest[]   @relation("LeaveApprovedBy")
  grievances        Grievance[]
  leaveBalances     LeaveBalance[]
  sessions          Session[]
}

model Attendance {
  attendance_id   String    @id @default(uuid())
  employee_id     String
  employee        Employee  @relation(fields: [employee_id], references: [employee_id])
  date            DateTime  @db.Date
  check_in_time   DateTime? @db.Timestamp
  check_out_time  DateTime? @db.Timestamp
  total_hours     Decimal?  @db.Decimal(5, 2)
  status          String    @db.VarChar(20)
  device_info     String?   @db.VarChar(100)
}

model LeaveType {
  leave_type_id   String          @id @default(uuid())
  name            String          @unique @db.VarChar(50)
  description     String?         @db.Text
  is_paid         Boolean         @default(true)
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
}

model LeaveRequest {
  leave_id       String     @id @default(uuid())
  employee_id    String
  employee       Employee   @relation("LeaveRequestEmployee", fields: [employee_id], references: [employee_id])
  leave_type_id  String
  leaveType      LeaveType  @relation(fields: [leave_type_id], references: [leave_type_id])
  start_date     DateTime   @db.Date
  end_date       DateTime   @db.Date
  reason         String?    @db.Text
  status         String     @default("Pending") @db.VarChar(20)
  approved_by    String?
  approvedBy     Employee?  @relation("LeaveApprovedBy", fields: [approved_by], references: [employee_id])
  created_at     DateTime   @default(now()) @db.Timestamp
}

model LeaveBalance {
  balance_id      String     @id @default(uuid())
  employee_id     String
  employee        Employee   @relation(fields: [employee_id], references: [employee_id])
  leave_type_id   String
  leaveType       LeaveType  @relation(fields: [leave_type_id], references: [leave_type_id])
  total_days      Int
  used_days       Int        @default(0)
  remaining_days  Int
}

model Grievance {
  grievance_id  String    @id @default(uuid())
  employee_id   String?
  employee      Employee? @relation(fields: [employee_id], references: [employee_id])
  title         String    @db.VarChar(150)
  description  String    @db.Text
  category      String    @db.VarChar(50)
  is_anonymous  Boolean   @default(false)
  status        String    @default("Under Review") @db.VarChar(30)
  created_at    DateTime  @default(now()) @db.Timestamp
}

model Session {
  token_id     String   @id @default(uuid())
  employee_id  String
  employee     Employee @relation(fields: [employee_id], references: [employee_id])
  token        String   @db.Text
  expiry_date  DateTime @db.Timestamp
}
